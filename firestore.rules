rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Turnos / Clases: Lectura pública para alumnos; creación/edición de turnos
    match /pilates_shifts/{shiftId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reservas: Permite a los alumnos crear reservas públicas y modificar/cancelar/eliminar
    match /pilates_bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Directorio de Alumnos: Registro al reservar y gestión
    match /pilates_clients/{clientId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Instructores y Staff:
    match /pilates_instructors/{instructorId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Disciplinas:
    match /pilates_disciplines/{disciplineId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Planes y Membresías:
    match /pilates_plans/{planId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    
    // Historial de Notificaciones y Emails:
    match /pilates_emails/{emailId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Configuración del Estudio:
    match /pilates_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
